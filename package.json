{
  "name": "vueleaflet",
  "version": "3.0.3",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vueleaflet.umd.js",
  "module": "./dist/vueleaflet.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vueleaflet.es.js",
      "require": "./dist/vueleaflet.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vp dev --config vite.example.config.ts",
    "build:example": "vp build --config vite.example.config.ts",
    "build:js": "vp build",
    "build": "pnpm run build:js && pnpm exec vue-tsc --emitDeclarationOnly",
    "check:dist": "pnpm build && node scripts/check-dist.mjs",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "test": "vp test run",
    "test:watch": "vp test"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.6.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.1.1",
    "release-it": "^20.0.1",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.20",
    "vite-plus": "^0.1.20",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.8"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.0.9"
}
