{
  "name": "vueleaflet",
  "version": "3.0.2",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vueleaflet.umd.js",
  "module": "./dist/vueleaflet.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vueleaflet.es.js",
      "require": "./dist/vueleaflet.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite dev --config vite.example.config.ts",
    "build:example": "vite build --config vite.example.config.ts",
    "build:js": "vite build",
    "build": "pnpm run build:js && pnpm exec vue-tsc --emitDeclarationOnly",
    "check:dist": "pnpm build && node scripts/check-dist.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.6.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "release-it": "^20.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
